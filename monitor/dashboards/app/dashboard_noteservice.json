          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  date_trunc('minute', created_at) AS time,  -- 可以改成 'hour' 或 'day'\r\n  SUM(COALESCE(input_token,0) + COALESCE(output_token,0)) AS value\r\nFROM\r\n  public.chat_history\r\nWHERE\r\n  $__timeFilter(created_at)  -- Grafana 自動替換時間範圍\r\nGROUP BY\r\n  date_trunc('minute', created_at)\r\nORDER BY\r\n  time ASC;\r\n",
          "refId": "A",
